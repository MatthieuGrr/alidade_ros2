# Peripheriques USB d'Alidade : noms stables, independants de l'ordre de
# branchement, et droits au groupe dialout pour ne pas lancer ROS en root.
#
# Installer : sudo cp 99-alidade.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# Verifier  : ls -l /dev/rplidar /dev/pico ; lsusb pour les identifiants.

# RPLIDAR C1 : pont serie CP210x (Silicon Labs), famille ttyUSB.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0660", GROUP="dialout", SYMLINK+="rplidar"

# Raspberry Pi Pico 2 en CDC, famille ttyACM. diffdrive_pico_firmware s'annonce
# avec un descripteur USB dedie (USBD_PRODUCT / USBD_MANUFACTURER dans son
# CMakeLists.txt) : on filtre dessus, et non sur le vendeur 2e8a commun a
# toutes les cartes Raspberry Pi. Le firmware releve USBD_DESC_STR_MAX pour
# que le nom ne soit pas tronque a 19 caracteres, sinon rien ne correspondrait.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{manufacturer}=="MatthieuGrr", ATTRS{product}=="diffdrive_pico_firmware", MODE="0660", GROUP="dialout", SYMLINK+="pico"

# Pour epingler un exemplaire precis, ajouter ATTRS{serial}=="..." lu par :
#   udevadm info -a -n /dev/ttyACM0 | grep serial
