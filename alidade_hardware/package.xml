<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>alidade_hardware</name>
  <version>1.0.0</version>
  <description>Interface ros2_control d'Alidade vers diffdrive_pico_firmware : trames S a 50 Hz, consignes en ticks/s, IMU brute</description>
  <maintainer email="matthieu.georger@gmail.com">Matthieu Georger</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
